rule bwa_index:
    input:
        ref=config['reference'],
        precheck=ancient("reports/precheck.done")
    output:
        ALIGNER_INDEX_FILES
    params:
        aligner=ALIGNER_NAME,
        executable=ALIGNER_CONFIG.get("executable", "bwa-mem2"),
        index_threads=ALIGNER_CONFIG.get("index_threads", 4),
        index_extra=ALIGNER_CONFIG.get("index_extra", "")
    log:
        "logs/index/bwa_index.log"
    threads:
        int(ALIGNER_CONFIG.get("index_threads", 4))
    shell:
        """
        if [ "{params.aligner}" = "minibwa" ]; then
            {params.executable} index \
                -t {params.index_threads} \
                {params.index_extra} \
                {input.ref} \
                > {log} 2>&1
        else
            {params.executable} index \
                {params.index_extra} \
                {input.ref} \
                > {log} 2>&1
        fi
        """
